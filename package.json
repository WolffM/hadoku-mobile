{
  "name": "hadoku-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "One Android app for every hadoku.me site: a Capacitor WebView shell over the live launcher, native only where the web cannot go.",
  "scripts": {
    "sync": "cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease"
  },
  "packageManager": "pnpm@11.5.0",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
