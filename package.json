{
  "name": "hadoku-mobile",
  "version": "0.1.5",
  "private": true,
  "description": "One Android app for every hadoku.me site: a Capacitor WebView shell over the live launcher, native only where the web cannot go.",
  "scripts": {
    "sync": "cap sync android",
    "android:build": "cd android && ./gradlew :app:assembleDebug",
    "android:release": "cd android && ./gradlew :app:assembleRelease",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "cd android && ./gradlew :app:testDebugUnitTest",
    "emulator": "scripts/emulator.sh",
    "emulator:sign-in": "scripts/emulator.sh && (cd android && ./gradlew -q :app:installDebug) && node ../hadoku_site/scripts/secrets/dev-vault.mjs -- node scripts/emulator-sign-in.mjs",
    "test:device": "scripts/emulator.sh && cd android && ./gradlew :app:connectedDebugAndroidTest",
    "test:player-real": "scripts/emulator.sh && scripts/test-player-real.sh",
    "test:download-resume": "scripts/emulator.sh && scripts/test-download-resume.sh",
    "test:library-live": "scripts/emulator.sh && scripts/test-library-live.sh",
    "e2e": "scripts/emulator.sh && (cd android && ./gradlew -q :app:installDebug) && playwright test -c e2e/playwright.config.ts --project shell",
    "e2e:signed-in": "scripts/emulator.sh && (cd android && ./gradlew -q :app:installDebug) && node ../hadoku_site/scripts/secrets/dev-vault.mjs -- playwright test -c e2e/playwright.config.ts --project signed-in",
    "release": "node scripts/release.mjs"
  },
  "packageManager": "pnpm@11.5.0",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "playwright": "1.64.1",
    "typescript": "^5.9.3"
  }
}
